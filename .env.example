# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 넣으세요. (.env 는 제출물에 넣지 않습니다)

# LLM: none(규칙 기반만) | anthropic | openai
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 기상청 API (비워 두면 기본 풍향: 남풍 4m/s — 광령양돈단지가 마을 남쪽에 있음)
KMA_API_KEY=
DEFAULT_WIND_FROM_DEG=180
DEFAULT_WIND_SPEED=4

# 판단 기준값
WINDOW_MIN=60
CAUTION_MIN_PEOPLE=4
ALARM_MIN_PEOPLE=10
CAUTION_AVG_INTENSITY=4
PERSIST_HOURS=3

# 악취배출시설 정확한 좌표 (브이월드 지번 주소 → 좌표). 비우면 '리' 중심 근사값
# 키 발급: https://www.vworld.kr → 넣은 뒤 python scripts/prepare_facilities.py 다시 실행
VWORLD_API_KEY=
# 지도에 사업장명 표시 (기본 false: 신고 지점과 나란히 보이면 원인 지목으로 읽힐 수 있음)
FACILITY_SHOW_NAMES=false
